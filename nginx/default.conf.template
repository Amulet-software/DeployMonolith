server {
  listen 80 default_server;
  server_name _;

  # SiteMonolit owns the public compatibility gateway. This keeps legacy
  # /version_monolith.txt and /monolith/* metadata bound to the Site's physical
  # contour instead of exposing a global Hub catalog here.
  location / {
    proxy_pass http://site:80;
    include /etc/nginx/proxy.conf;
  }
}
server {
  listen 8080 default_server;
  server_name _;
  client_max_body_size 2g;
  proxy_read_timeout 300s;

  location / {
    proxy_pass http://hub:8080;
    include /etc/nginx/proxy.conf;
  }
}
