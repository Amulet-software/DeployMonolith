# Public DNS names. Point all four records to this server.
PROD_SITE_HOST=amuletsimple.ru
PROD_HUB_HOST=hub.amuletsimple.ru
TEST_SITE_HOST=test.amuletsimple.ru
TEST_HUB_HOST=hub-test.amuletsimple.ru
PROD_HUB_PUBLIC_BASE_URL=http://hub.amuletsimple.ru
TEST_HUB_PUBLIC_BASE_URL=http://hub-test.amuletsimple.ru

# Source revisions (branch, tag or commit). Pin tags/commits for reproducible releases.
HUB_REPOSITORY=https://github.com/Amulet-software/HubMonolith.git
HUB_REF=main
SITE_REPOSITORY=https://github.com/Amulet-software/SiteMonolit.git
SITE_REF=main

# Generated by bootstrap.sh if left unchanged.
PROD_POSTGRES_PASSWORD=change-me
PROD_HUB_ADMIN_KEY=change-me
TEST_POSTGRES_PASSWORD=change-me
TEST_HUB_ADMIN_KEY=change-me

PROD_HUB_CORS_ORIGINS=["http://amuletsimple.ru"]
TEST_HUB_CORS_ORIGINS=["http://test.amuletsimple.ru"]
HUB_REQUIRE_SIGNED_MONMOD=true
HUB_AUTO_SEED=false
HUB_LOG_LEVEL=INFO

# Host paths. Relative values are resolved from this repository.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
