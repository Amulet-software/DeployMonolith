DEPLOY_PROFILE=dev
DEPLOY_ENABLED=true

# Containers listen on all local interfaces. bootstrap.sh resolves the public
# Development address on the clean Linux host and writes it to .env.dev.
SITE_BIND_IP=0.0.0.0
SITE_PORT=80
HUB_BIND_IP=0.0.0.0
HUB_PORT=8080
SITE_PUBLIC_URL=http://127.0.0.1
HUB_PUBLIC_BASE_URL=http://127.0.0.1:8080
SITE_CONTOUR_ID=dev
SITE_ENABLE_DEVELOPMENT=true
HUB_CORS_ORIGINS=["http://127.0.0.1"]

# One Hub serves all logical contours/channels. The logical contour is sent by
# the Monolith client; this value describes the Hub deployment itself.
HUB_ENVIRONMENT=shared
POSTGRES_PASSWORD=change-me
HUB_ADMIN_KEY=change-me
HUB_REQUIRE_SIGNED_MONMOD=true
HUB_AUTO_SEED=false

HUB_REPOSITORY=git@github-hubmonolith:Amulet-software/HubMonolith.git
HUB_REF=main
SITE_REPOSITORY=git@github-sitemonolit:Amulet-software/SiteMonolit.git
SITE_REF=main

# Optional legacy HTTPS token file. Release Manager provisions read-only SSH
# deploy keys, so normal DEV deployment does not need this value.
GITHUB_TOKEN_FILE=
